# The text splitter → embedder → vector store pattern is the heart of RAG. 

def prepare_data_pipeline(embedder_type: str = "openai"):
    """
    Split documents → Create embeddings → Store vectors. 
    This three-stage pipeline powers all retrieval in DeepWiki.
    """
    splitter = TextSplitter(
        split_by="word",
        chunk_size=400,
        chunk_overlap=200
    )
    
    embedder = get_embedder(embedder_type)  # OpenAI, Google, Ollama, Bedrock
    
    embedder_transformer = ToEmbeddings(embedder=embedder, batch_size=500)
    
    return Sequential(splitter, embedder_transformer)


def read_all_documents(path: str, excluded_dirs: list = None):
    """
    Document ingestion with intelligent filtering.
    Code files prioritized over docs, test files deprioritized. 
    """
    CODE_EXTENSIONS = [". py", ".js", ".ts", ".java", ".go", ".rs", ".cpp"]
    DOC_EXTENSIONS = [". md", ".txt", ".rst", ".json", ".yaml"]
    
    documents = []
    for ext in CODE_EXTENSIONS + DOC_EXTENSIONS:
        for file_path in glob(f"{path}/**/*{ext}", recursive=True):
            if should_process_file(file_path, excluded_dirs):
                content = read_file(file_path)
                documents.append(Document(
                    text=content,
                    meta_data={
                        "file_path":  file_path,
                        "is_code": ext in CODE_EXTENSIONS,
                        "is_implementation": "test" not in file_path. lower()
                    }
                ))
    return documents


# =============================================================================
# ARCHITECTURAL DNA: The RAG Component
# =============================================================================

class RAG(Component):
    """
    The "Aha" class: Once you understand RAG, you understand DeepWiki. 
    
    RAG = Repository + Embeddings + FAISS + LLM Generator
    Every feature (Ask, DeepResearch, Wiki Generation) is built on this. 
    """
    
    def __init__(self, provider="google", model=None):
        self.provider = provider
        self.model = model
        self. embedder = get_embedder()
        self.memory = Memory()  # Conversation history
        self.db_manager = DatabaseManager()
        
        # The generator uses dynamic model configuration
        generator_config = get_model_config(provider, model)
        self.generator = Generator(
            template=RAG_TEMPLATE,
            model_client=generator_config["model_client"](),
            model_kwargs=generator_config["model_kwargs"]
        )
    
    def prepare_retriever(self, repo_url: str, repo_type: str = "github", 
                          access_token: str = None):
        # Clone → Parse → Embed → Index
        self.transformed_docs = self.db_manager.prepare_database(
            repo_url, repo_type, access_token
        )
        
        # Validate embedding dimensions (critical for FAISS)
        self.transformed_docs = self._validate_embeddings(self.transformed_docs)
        
        # Create FAISS retriever with document vectors
        self.retriever = FAISSRetriever(
            embedder=self.embedder,
            documents=self. transformed_docs,
            document_map_func=lambda doc: doc.vector
        )
    
    def __call__(self, query: str) -> list:
        # Semantic search:  query → embedding → nearest neighbors
        retrieved = self.retriever(query)
        retrieved[0].documents = [
            self.transformed_docs[idx] for idx in retrieved[0]. doc_indices
        ]
        return retrieved


