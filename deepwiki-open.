# =============================================================================
# IDENTITY CORE:  The Repository Ingestion → Embedding → RAG → Wiki Pipeline
# =============================================================================

# DeepWiki's unique insight: Treat any codebase as a knowledge base that can be
# queried, visualized, and documented automatically through a unified pipeline.

class WikiGenerationPipeline:
    """
    The core abstraction:  Repository → Embeddings → FAISS Index → RAG → Wiki Pages
    This pipeline is the DNA of DeepWiki - everything flows through it.
    """
    
    def __init__(self, repo_url:  str, provider: str = "google", model: str = None):
        self.repo_url = repo_url
        self.embedder = self._init_embedder()  # OpenAI, Google, Ollama, or Bedrock
        self. db_manager = DatabaseManager()
        self.retriever = None
        self.generator = self._init_generator(provider, model)
    
    def prepare(self, access_token: str = None):
        # Clone repo → Read documents → Chunk → Embed → Store in FAISS
        docs = self.db_manager.prepare_database(self.repo_url, access_token)
        self.retriever = FAISSRetriever(embedder=self.embedder, documents=docs)
    
    def query(self, question: str) -> str:
        # RAG:  Retrieve relevant code chunks → Augment prompt → Generate answer
        context = self.retriever(question)
        return self.generator.generate(question, context)


