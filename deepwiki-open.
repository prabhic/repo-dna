                "top_k": 40
            }
        },
        "openai": {
            "model_client": OpenAIClient,
            "model_kwargs": {
                "model": model or "gpt-4o",
                "temperature": 0.7,
                "top_p": 0.8
            }
        },
        "openrouter": {
            "model_client":  OpenRouterClient,
            "model_kwargs": {"model": model, "temperature": 0.7}
        },
        "ollama": {
            "model_client":  OllamaClient,
            "model_kwargs": {
                "model":  model or "llama3",
                "num_ctx": 8192
