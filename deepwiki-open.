# =============================================================================
# KEY INSIGHT: Everything is a Chat Completion with Context
# =============================================================================

# Whether it's wiki generation, Q&A, or research - the pattern is identical: 
# 1. Prepare RAG retriever for the repository
# 2. Retrieve relevant context for the query
# 3. Stream LLM response with that context

async def unified_generation_pattern(repo_url, query, provider, model):
    """The universal pattern behind all DeepWiki features."""
    rag = RAG(provider=provider, model=model)
    rag.prepare_retriever(repo_url)
    
    context = rag(query)
    
    prompt = f"""
    {SYSTEM_PROMPT}
    
    <context>
    {format_context(context)}
    </context>
    
    <query>{query}</query>
    """
    
    async for chunk in stream_llm_response(prompt, provider, model):
        yield chunk


