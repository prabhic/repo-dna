    }
    return PROVIDER_CONFIGS.get(provider, PROVIDER_CONFIGS["google"])


# =============================================================================
# SIGNATURE PATTERN 2:  Streaming WebSocket + HTTP Fallback
# =============================================================================

# DeepWiki uses WebSocket for real-time streaming with automatic HTTP fallback.
# This dual-transport pattern appears in wiki generation, chat, and research.

async def handle_websocket_chat(websocket: WebSocket):
    """
    The streaming pattern:  WebSocket primary, HTTP fallback.
    This is how DeepWiki achieves real-time wiki generation.
    """
    await websocket.accept()
    request = await websocket.receive_json()
    
    # Prepare RAG retriever for this repository
    rag = RAG(provider=request. provider, model=request. model)
    rag.prepare_retriever(request. repo_url, request. type, request.token)
    
    # Retrieve context and stream response
    context = rag(request.query)
    
    # Stream chunks via WebSocket
    async for chunk in generate_streaming_response(request, context):
        await websocket.send_text(chunk)
    
    await websocket.close()


